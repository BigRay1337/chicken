{
  "manifest_version": 3,
  "name": "HTML5 Universal Speed Hack",
  "description": "Speeds up or slows down browser games, HTML5 and more...",
  "version": "12.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "html5-universal-speed-hack@bigray1337.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {}
  },
  "host_permissions": ["<all_urls>"],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "HTML5 Universal Speed Hack Free",
    "default_popup": "index.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "all_frames": true,
      "world": "MAIN",
      "run_at": "document_start",
      "matches": ["<all_urls>"],
      "js": ["dateNowRefresh.js", "pageScript.js"]
    },
    {
      "all_frames": true,
      "world": "ISOLATED",
      "run_at": "document_start",
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}